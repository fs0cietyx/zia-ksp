# ==============================================================================
# ZIA (Zonal Intelligence Architecture) // Zoho Catalyst Environment Manifest
# ==============================================================================
# Copy this file to .env and configure for local development or production CI/CD.

# 1. SERVERLESS RUNTIME ENVIRONMENT
CATALYST_ENV=development
CATALYST_PROJECT_ID=60079426733
CATALYST_API_GATEWAY_URL=http://localhost:3000/server/ksp_intelligence_api

# 2. GEOSPATIAL HEATMAP ENGINE CONFIGURATION
MAX_HEAT_POINTS=10000
DEFAULT_DISTRICT=ALL
HEATMAP_RADIUS=70
HEATMAP_BLUR=62
HEATMAP_BASE_INTENSITY=0.05

# 3. SCIKIT-LEARN AI PREDICTIVE RISK SANDBOX
AI_RISK_THRESHOLD=0.78
RF_MODEL_ESTIMATORS=100
MAX_MIGRATION_VELOCITY=5.0
MAX_YOUTH_UNEMPLOYMENT=25.0

# 4. DATA SECURITY & CORS POLICY
CORS_ALLOW_ORIGIN=*
ENABLE_EVIDENTIARY_PROVENANCE=true
ALPR_SIMULATION_INTERVAL_MS=3500

# 5. EDGE CDN CACHE CONTROLS
CACHE_MAX_AGE_SEC=3600
ENABLE_GZIP_COMPRESSION=true
